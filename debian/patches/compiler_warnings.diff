@@ -2215,12 +2215,12 @@
 		p=strpbrk(s,"\335\336");
 		if (!p)
 		{
-			write(1,s,strlen(s));
+			if (write(1,s,strlen(s)) < 0) { /* best-effort console output; ignore */ }
 			return;
 		}
 		if (p!=s)
 		{
-			write(1,s,(size_t) (p-s));
+			if (write(1,s,(size_t) (p-s)) < 0) { /* best-effort console output; ignore */ }
 			s=p;
 		}
 		if (*p=='\336')
